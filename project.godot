; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="fpsrougegame"
run/main_scene="uid://q7ahpp2jpvmn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=165
config/icon="res://icon.svg"

[autoload]

InputHandler="*uid://clb1n71l7etk6"
GameManager="*uid://c70wwjhmd0rvw"
EventHandler="*uid://brun5ammttwaw"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="ignore"

[file_customization]

folder_colors={
"res://Enemies/": "yellow",
"res://Modifiers/": "green",
"res://Player/": "red",
"res://Player/Scripts/WeaponController/": "orange",
"res://Stages/": "gray",
"res://UI/": "blue",
"res://UI/PlayerUI/": "red",
"res://Weapons/": "pink",
"res://Weapons/Bullets/": "yellow"
}

